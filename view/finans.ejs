 <!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Hava Finans - Minimalist Dashboard</title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.css" />
    <style>
        :root {
            --glass-bg: rgba(15, 23, 42, 0.4); /* Arka planı daha çok gösterir */
            --glass-border: rgba(255, 255, 255, 0.08);
            --accent-blue: #38bdf8;
            --text-main: #f8fafc;
            --text-muted: #cbd5e1;
            --success: #4ade80;
            --danger: #f87171;
        }

        body {
            /* Karartma efektini azalttık */
            background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                        url('/images/finansyeni.jpg') no-repeat center center fixed;
            background-size: cover;
            color: var(--text-main);
            width: 100vw;
            height: 100vh;
            margin: 0;
            overflow: hidden;
            font-family: 'Segoe UI', system-ui, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container-fluid {
            width: 92%;
            height: 88%;
            display: flex;
            flex-direction: column;
        }

        /* HEADER */
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        #clock {
            font-size: 8rem;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -4px;
            text-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .date-info { text-align: right; }
        .day-text { font-size: 2.2rem; font-weight: 700; color: var(--accent-blue); text-transform: uppercase; }
        .date-text { font-size: 1.4rem; color: var(--text-muted); }

        /* KART GRID */
        .finance-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(4, 1fr);
            gap: 20px;
            flex-grow: 1;
        }

        /* KART TASARIMI */
        .asset-card {
            background: var(--glass-bg);
            backdrop-filter: blur(15px); /* Arka planı bulanıklaştırır, derinlik katar */
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 0 40px;
            display: flex;
            align-items: center;
            transition: transform 0.3s ease;
        }

        .asset-name {
            font-size: 2rem;
            font-weight: 700;
            flex: 0 0 30%;
        }

        .asset-price {
            font-size: 2.6rem;
            font-weight: 700;
            flex: 1;
            text-align: right;
            font-variant-numeric: tabular-nums;
            letter-spacing: -1px;
        }

        .asset-indicator {
            flex: 0 0 25%;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 15px;
        }

        .change-val { font-size: 1.6rem; font-weight: 600; }
        .symbol-val { font-size: 2rem; }

        /* RENKLER */
        .red { color: var(--danger); }
        .green { color: var(--success); }

    </style>
</head>

<body>
    <div class="container-fluid">
        <header class="header-section">
            <div id="clock"><%= time.hour %>:<%= time.minutes %></div>
            <div class="date-info">
                <div class="day-text"><%= time.dayName %></div>
                <div class="date-text"><%= time.day %> <%= time.month %> <%= time.year %></div>
            </div>
        </header>

        <main class="finance-grid">
            <% if (finans && finans.length > 0) { %>
                <% finans.forEach(function(item) { %>
                    <div class="asset-card">
                        <div class="asset-name"><%= item.name %></div>
                        <div class="asset-price"><%= item.selling %></div>
                        <div class="asset-indicator">
                            <span class="change-val <%= item.status_bg_color %>"><%= item.change %></span>
                            <span class="symbol-val <%= item.status_bg_color %>"><%- item.status_symbol %></span>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </main>
    </div>

    <script>
        function tick() {
            const now = new Date();
            document.getElementById('clock').innerText = 
                now.getHours().toString().padStart(2, '0') + ":" + 
                now.getMinutes().toString().padStart(2, '0');
        }
        setInterval(tick, 1000);
        tick();
    </script>
</body>
</html> 