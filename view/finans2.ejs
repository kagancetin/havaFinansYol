<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Hava Finans - Modern TV Dashboard</title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.css" />
    <style>
        :root {
            --glass-bg: rgba(15, 23, 42, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
            --accent-blue: #38bdf8;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --success: #22c55e;
            --danger: #ef4444;
        }

        body {
            background: linear-gradient(rgba(10, 15, 30, 0.8), rgba(10, 15, 30, 0.8)), 
                        url('/images/finansyeni.jpg') no-repeat center center fixed;
            background-size: cover;
            color: var(--text-main);
            width: 100vw; height: 100vh;
            margin: 0; padding: 0; overflow: hidden;
            font-family: 'Inter', sans-serif;
            display: flex; align-items: center; justify-content: center;
        }

        .financeMain { width: 92%; height: 90%; display: flex; flex-direction: column; }

        .main-header {
            display: flex; justify-content: space-between; align-items: flex-end;
            padding-bottom: 2%; border-bottom: 1px solid var(--glass-border); margin-bottom: 3%;
        }

        .mainHour {
            font-size: 8rem; font-weight: 900; line-height: 0.9; letter-spacing: -2px;
            background: linear-gradient(to bottom, #fff, #cbd5e1);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .date-container { text-align: right; }
        .mainDay { font-size: 2.5rem; font-weight: 700; color: var(--accent-blue); text-transform: uppercase; }
        .mainDate { font-size: 1.5rem; color: var(--text-muted); }

      .main-body-items {
            display: block; /* Grid iptal */
            width: 100%;
            height: auto;
        }

        /* Float'ların taşmasını engellemek için gerekli temizlik (clearfix) */
        .main-body-items:after {
            content: "";
            display: table;
            clear: both;
        }

        /* 2. Blokları yan yana getiriyoruz */
        .finance-block {
            float: left; /* Yan yana dizilme komutu */
            width: 47%; /* 2 sütun için (boşluk payı ile birlikte) */
            margin: 1%; /* Bloklar arası dış boşluk */
            
            /* Stil özellikleri (dokunmadık) */
            background: var(--glass-bg);
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border); 
            border-radius: 1.5rem;
            padding: 20px 2%; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            box-sizing: border-box; /* Padding genişliği bozmasın */
            
            /* İçerik hizalama için flexbox'ı korudum (blur çalışıyorsa bu da çalışır) */
            display: flex; 
            align-items: center;
        }

        /* Dinamik kenarlık vurgusu */
        .finance-block.up { border-left: 8px solid var(--success); }
        .finance-block.down { border-left: 8px solid var(--danger); }

        .asset-name-label { font-size: 2.2rem; font-weight: 800; flex: 0 0 35%; }
        .price-text { 
            font-size: 2.8rem; font-weight: 700; flex: 1; text-align: right; 
            font-variant-numeric: tabular-nums; color: #fff;
        }

        .indicator-group { flex: 0 0 25%; display: flex; align-items: center; justify-content: flex-end; gap: 15px; }
        .change-text { font-size: 1.6rem; font-weight: 600; padding: 4px 12px; border-radius: 8px; }
        .status-box { font-size: 2rem; display: flex; align-items: center; }

        .red { color: var(--danger); }
        .green { color: var(--success); }
    </style>
</head>

<body>
    <div class="financeMain">
        <header class="main-header">
            <div class="mainHour" id="clock"><%= time.hour %>:<%= time.minutes %></div>
            <div class="date-container">
                <div class="mainDay"><%= time.dayName %></div>
                <div class="mainDate"><%= time.day %> <%= time.month %> <%= time.year %></div>
            </div>
        </header>

        <main class="main-body">
            <div class="main-body-items">
                <% if (finans && finans.length > 0) { %>
                    <% finans.forEach(function(item) { %>
                        <div class="finance-block <%= item.status_bg_color === 'green' ? 'up' : 'down' %>">
                            <span class="asset-name-label"><%= item.name %></span>
                            <span class="price-text"><%= item.selling %></span>

                            <div class="indicator-group">
                                <span class="change-text <%= item.status_bg_color %>"><%= item.change %></span>
                                <span class="status-box">
                                    <strong class="<%= item.status_bg_color %>"><%- item.status_symbol %></strong>
                                </span>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </main>
    </div>

    <script>
        function updateClock() {
            const now = new Date();
            document.getElementById('clock').innerText = 
                now.getHours().toString().padStart(2, '0') + ":" + 
                now.getMinutes().toString().padStart(2, '0');
        }
        setInterval(updateClock, 1000); updateClock();
    </script>
</body>
</html>